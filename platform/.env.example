# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner .env.

# Mode développement local uniquement. Mettre False en production.
DJANGO_DEBUG=True
# Obligatoire hors développement : générer une valeur longue et aléatoire, par exemple
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines HTTPS de confiance pour CSRF en production (ex. https://app.example.org)
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
POSTGRES_DB=systemc
POSTGRES_USER=systemc
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Fuseau horaire d'affichage (stockage toujours en UTC)
TIME_ZONE=UTC
SYSTEMC_DEFAULT_CURRENCY=USD

# Production derrière un reverse proxy TLS
# DJANGO_BEHIND_TLS_PROXY=True
# DJANGO_SECURE_SSL_REDIRECT=True
